<style>
 #rq-sidebar {
     position:relative;
     /* height: calc(100dvh - 49px - 4rem); */
     width: 20em;
     min-width: 20em;
     margin-top: 1rem;
     /*border-right: none;*/
     margin-left: 0;
     margin-right: 0;
     display: flex;
     flex-direction: column;
     padding-right: env(safe-area-inset-right, 0);
     transition: width 0.2s ease, transform 0.2s ease;
     -webkit-transition: width 0.2s ease, -webkit-transform 0.2s ease;
 }

 #rq-tools > summary {
     cursor: pointer;
 }

 #rq-tools > summary h3 {
     display: inline;
 }

 #rq-tools-body {
     padding-top: 0.5em;
 }

 #rq-skip-select {
     display: block;
     width: 100%;
     box-sizing: border-box;
 }

 #rq-error-notice {
     display: none;
     background: var(--color-error-bg);
     border: var(--color-error-border);
     color: var(--color-error-text);
 }

 #rq-page-container {
     display: flex;
     justify-content: center;
     gap: 2rem;
 }

 #rq-error-list {
     padding-left: 1em;

     > li {
	 margin-block-end: 1em;
     }
 }

 .faq details > div {
     background-color: var(--color-nav-bg);
     padding: 0.5em;
     margin-top: 0.25em;
     border: 1px solid var(--color-secondary);
 }
</style>

<template id="rq-sidebar-template">
    <div id="rq-sidebar" class="ui container">
	<div class="rq-logo-badge">
	    <img class="rq-logo" src="/assets/rq-logo.svg" />
	</div>
        <div class="ui attached segment">
            <div class="ui floating">
		<h3>
                    {{svg "octicon-book" 16 "tw-text-placeholder-text"}}
                    Your Quest
		</h3>

	    </div>
            <div class="ui list">
                <strong>Title: </strong><a href="" id="current-quest-link"></a>
            </div>

	</div>
        <div class="ui attached segment">
            <div class="ui floating">
                <h3>
                    {{svg "octicon-tasklist" 16 "tw-text-placeholder-text"}}
                    Current Challenge
                </h3>
            </div>
            <div class="ui list">
                <strong>Description: </strong><span id="current-task-name"></span>
            </div>
	    <div class="ui list">
                <strong>Branch: </strong><code><a href="" id="current-branch-name"></a></code>
            </div>
            <div class="ui list">
                <span><a id="current-task-link">
		    {{svg "octicon-issue-opened" 16 "tw-text-placeholder-text"}}
		    Issue
		</a></span> |
		<span><a id="current-pr-link">
		    {{svg "octicon-git-pull-request" 16 "tw-text-placeholder-text"}}
		    Pull Request
		</a></span>
            </div>
	</div>
        <div class="ui attached segment faq">
	    <div class="ui floating">
                <h3>
                    {{svg "octicon-question" 16 "tw-text-placeholder-text"}}
                    Quest Help
                </h3>
            </div>
            <div class="ui list">
		<details>
		    <summary>How do I complete this challenge?</summary>
		    <div>
			<p>If you can't figure out a solution, you can either read or directly use the reference solution. Click the button below to create a PR onto your challenge branch containing the reference solution. You can read it and close it, or merge it.</p>
			<div id="solution-button" class="tw-mt-2"></div>
		    </div>
		</details>
	    </div>
	    <div class="ui list">
		<details>
		    <summary>How do I go to the next challenge?</summary>
		    <div>
			<p>
			    The next challenge appears once you have (1) merged the current challenge's pull request, and (2) closed the current challenge's issue. Make sure the challenge PR is merged (not closed), and then refresh the page if no changes appear.
			</p>
		    </div>
		</details>
	    </div>
	    <div class="ui list">
		<details>
		    <summary>How do I report a bug?</summary>
		    <div>
			<p>
			    If the bug is more related to your current quest (e.g. typos in issues, confusing code), please file an issue on <a href="" id="quest-bug-link">its repository</a>.
			</p>
			<p>If the bug is more related to RepoQuest, please file an issue on <a href="https://github.com/cognitive-engineering-lab/repo-quest">its repository</a>.</p>
			<p>You can also join <a href="https://cognitive-engineering-lab.zulipchat.com/#narrow/channel/453057-repo-quest">our Zulip</a> to discuss any issues.</p>
		    </div>
		</details>
	    </div>
        </div>
        <div class="ui attached segment">
            <details id="rq-tools">
                <summary>
                    <h3>
                        {{svg "octicon-tools" 16 "tw-text-placeholder-text"}}
                        Quest Tools
                    </h3>
                </summary>
                <div id="rq-tools-body">
                    <div class="ui list">
                        <strong>Skip ahead</strong>
                    </div>
                    <!-- Deliberately not `ui dropdown`: Forgejo initializes
                         every such element into a Fomantic dropdown, which
                         hides the native select and sizes itself to content. -->
                    <select id="rq-skip-select"></select>
                </div>
            </details>
        </div>
        <div id="rq-error-notice" class="ui attached segment">
            <h3>Error</h3>
            RepoQuest has encountered errors. Please <a href="https://github.com/cognitive-engineering-lab/repo-quest/issues/new">submit a bug report</a> that includes the quests you have installed and <a href="{{AppSubUrl}}/rq/error/log">the server error messages</a> and any error messages below.
            <ul id="rq-error-list">
            </ul>
            <button id="rq-error-clear">Clear all errors.</button>
        </div>
    </div>
</template>

<script>
 window.appSubUrl = "{{AppSubUrl}}";
 window.repoId = "{{.Repository.ID}}";
</script>
<script src="/assets/rq-sidebar.js" defer></script>
